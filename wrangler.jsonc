{
  // ============================================================
  // Cloudflare Workers 정적 사이트 설정
  // ------------------------------------------------------------
  // Netlify 의 "Build output directory: site" 에 해당하는 설정을
  // Workers 에서는 이 파일의 assets.directory 로 지정한다.
  //
  // 배포는 저장소에 연결된 빌드가 `npx wrangler deploy` 로 자동 실행한다.
  // (main 브랜치에 push → 자동 배포)
  // ============================================================

  "name": "mytruck",
  "compatibility_date": "2026-08-01",

  "assets": {
    // 배포할 폴더 — 이 안의 파일이 사이트 루트가 된다.
    "directory": "./site",

    // 없는 주소로 들어오면 404 페이지를 보여준다.
    // (SPA 가 아니라 여러 개의 정적 HTML 이므로 single-page-application 아님)
    "not_found_handling": "404-page",

    // /quote.html 로 들어와도 /quote 로 정리해서 보여준다.
    // site/_redirects 의 /quote → /quote.html 규칙과 함께 동작한다.
    "html_handling": "auto-trailing-slash"
  },

  "observability": {
    "enabled": true
  }
}
